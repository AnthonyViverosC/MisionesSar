# =============================================================================
# MISIONES SAR — variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# `.env.local` nunca se versiona: está excluido en .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — proyecto en la nube
# Panel del proyecto → Settings → API
# -----------------------------------------------------------------------------

# URL pública del proyecto. Se expone al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima. Se expone al navegador: es segura porque toda lectura y
# escritura pasa por las políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. SALTA TODAS LAS POLÍTICAS DE RLS.
# Solo se usa en el servidor (Server Actions, Route Handlers y semilla).
# Nunca la prefijes con NEXT_PUBLIC_ ni la importes en un componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Contraseña de la base de datos, necesaria para `pnpm db:push`.
# Panel del proyecto → Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Identificador del proyecto (la parte variable de la URL), para enlazar el CLI.
SUPABASE_PROJECT_REF=

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

# URL base de la aplicación. En local, http://localhost:3000.
# En producción, la URL de Vercel o el dominio institucional.
NEXT_PUBLIC_URL_APLICACION=http://localhost:3000

# Minutos de inactividad antes de cerrar la sesión.
NEXT_PUBLIC_MINUTOS_INACTIVIDAD=30

# -----------------------------------------------------------------------------
# Solo para las pruebas de integración de RLS (opcional en producción)
# Credenciales de los usuarios que crea la semilla.
# -----------------------------------------------------------------------------
PRUEBAS_CLAVE_USUARIOS=Sar.Pruebas.2026!
